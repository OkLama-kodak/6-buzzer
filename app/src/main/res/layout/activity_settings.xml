<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#17191B"
    android:padding="12dp"
    tools:context=".Test.settings">

    <!-- Yellow Dashboard Container -->
    <LinearLayout
        android:id="@+id/dashboard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/bg_dashboard_gradient"
        android:padding="18dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/symbol_menu"
                android:textColor="#25231D"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/btnStar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/symbol_star"
                android:textColor="#25231D"
                android:textSize="28sp" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/title_settings"
            android:textColor="#24221D"
            android:textSize="42sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed" />

        <!-- Force Stop Button -->
        <Button
            android:id="@+id/button13"
            android:layout_width="140dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#FFB91F"
            android:elevation="0dp"
            android:padding="4dp"
            android:text="@string/btn_force_stop"
            android:textColor="#25241F"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <!-- Section heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="@string/section_preferences"
            android:textColor="#62512D"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- Setting Item 1: Add Date -->
        <LinearLayout
            android:id="@+id/button5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:background="@drawable/bg_task_card_done">

            <TextView
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:text="@string/symbol_bullet"
                android:textColor="#F4AC19"
                android:textSize="23sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set1_title"
                    android:textColor="#242A2D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/set1_sub"
                    android:textColor="#667982"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_priority_high"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/badge_edit"
                android:textColor="#563B00"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Setting Item 2: Add Schoolworks -->
        <LinearLayout
            android:id="@+id/button6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:background="@drawable/bg_task_card_blue">

            <TextView
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:text="@string/symbol_bullet"
                android:textColor="#58B4D0"
                android:textSize="23sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set2_title"
                    android:textColor="#242A2D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/set2_sub"
                    android:textColor="#667982"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_priority_medium"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/badge_edit"
                android:textColor="#17323B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Setting Item 3: Force Stop -->
        <LinearLayout
            android:id="@+id/cardForceStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:background="@drawable/bg_task_card_green">

            <TextView
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:text="@string/symbol_bullet"
                android:textColor="#43A68C"
                android:textSize="23sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set3_title"
                    android:textColor="#242A2D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/set3_sub"
                    android:textColor="#667982"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_priority_low"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/badge_action"
                android:textColor="#173B32"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom navigation bar -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="66dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_bottom_nav"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/nav_home"
            android:textColor="#B8B8B8"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/navTasks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/nav_tasks"
            android:textColor="#B8B8B8"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/nav_settings"
            android:textColor="#FFD04B"
            android:textStyle="bold"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
