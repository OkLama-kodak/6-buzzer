<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#17191B"
    android:padding="12dp"
    tools:context=".MainActivity">

    <!-- Yellow Dashboard Container -->
    <LinearLayout
        android:id="@+id/dashboard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/bg_dashboard_gradient"
        android:padding="20dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/symbol_menu"
                android:textColor="#25231D"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/btnStar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/symbol_star"
                android:textColor="#25231D"
                android:textSize="28sp" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/title_buzzers"
            android:textColor="#24221D"
            android:textSize="42sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed" />

        <!-- Dashboard Action Button -->
        <Button
            android:id="@+id/buttonGear"
            android:layout_width="145dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#FFB91F"
            android:elevation="0dp"
            android:padding="4dp"
            android:text="@string/btn_dashboard"
            android:textColor="#25241F"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <!-- Section Heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:text="@string/section_categories"
            android:textColor="#62512D"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- 2x2 Category Cards Grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:useDefaultMargins="false">

            <!-- Card 1: TASKS -->
            <LinearLayout
                android:id="@+id/buttonTasks"
                android:layout_width="0dp"
                android:layout_height="135dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="12dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_task_card_done"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/symbol_bullet"
                        android:textColor="#F4AC19"
                        android:textSize="22sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/title_tasks"
                    android:textColor="#242A2D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tasks_desc"
                    android:textColor="#667982"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Card 2: CALENDAR -->
            <LinearLayout
                android:id="@+id/buttonCalendar"
                android:layout_width="0dp"
                android:layout_height="135dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="12dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_task_card_blue"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/symbol_bullet"
                        android:textColor="#58B4D0"
                        android:textSize="22sp" />


                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/title_calendar"
                    android:textColor="#242A2D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/cal_desc"
                    android:textColor="#667982"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Card 3: REMINDERS -->
            <LinearLayout
                android:id="@+id/buttonReminders"
                android:layout_width="0dp"
                android:layout_height="135dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_task_card_green"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/symbol_bullet"
                        android:textColor="#43A68C"
                        android:textSize="22sp" />


                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/title_reminders"
                    android:textColor="#242A2D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/rem_desc"
                    android:textColor="#667982"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Card 4: ALARMS -->
            <LinearLayout
                android:id="@+id/buttonAlarms"
                android:layout_width="0dp"
                android:layout_height="135dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_task_card_done"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/symbol_bullet"
                        android:textColor="#E57373"
                        android:textSize="22sp" />


                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/title_alarms"
                    android:textColor="#242A2D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/alarm_desc"
                    android:textColor="#667982"
                    android:textSize="11sp" />
            </LinearLayout>

        </GridLayout>

    </LinearLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="66dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_bottom_nav"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/nav_home"
            android:textColor="#FFD04B"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/navTasks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/nav_tasks"
            android:textColor="#B8B8B8"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/nav_settings"
            android:textColor="#B8B8B8"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
