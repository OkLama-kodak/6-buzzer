
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/task_background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Dark gray header -->
    <View
        android:id="@+id/topBackground"
        android:layout_width="0dp"
        android:layout_height="280dp"
        android:background="@drawable/header_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Rounded yellow content background -->
    <View
        android:id="@+id/yellowPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/yellow_panel"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Jake the Dog banner -->
    <ImageView
        android:id="@+id/jakeBanner"
        android:layout_width="0dp"
        android:layout_height="125dp"
        android:layout_marginTop="42dp"

        android:scaleType="fitCenter"
        android:contentDescription="Jake the Dog"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TASKS title -->
    <TextView
        android:id="@+id/tasksTitle"
        android:layout_width="0dp"
        android:layout_height="78dp"
        android:layout_marginStart="92dp"
        android:layout_marginTop="130dp"
        android:layout_marginEnd="95dp"
        android:background="@drawable/title_gradient"
        android:gravity="center"
        android:fontFamily="sans-serif-condensed"
        android:text="TASKS"
        android:textColor="#FFFFFF"
        android:textSize="66sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Nonfunctional Add task button -->
    <TextView
        android:id="@+id/addTaskButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="133dp"
        android:layout_marginEnd="5dp"
        android:background="@drawable/button_gradient"
        android:gravity="center"
        android:paddingStart="17dp"
        android:paddingEnd="17dp"
        android:text="Add task"
        android:textColor="#FFFFFF"
        android:textSize="25sp"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        android:maxLines="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Task 1 -->
    <TextView
        android:id="@+id/taskOne"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_marginTop="255dp"
        android:gravity="center"
        android:fontFamily="sans-serif-condensed"
        android:text="TASK 1: DONE"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="24sp"
        android:autoSizeMaxTextSize="48sp"
        android:autoSizeStepGranularity="2sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Task 2 -->
    <TextView
        android:id="@+id/taskTwo"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_marginTop="365dp"
        android:gravity="center"
        android:fontFamily="sans-serif-condensed"
        android:text="TASK 2: DUE"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="24sp"
        android:autoSizeMaxTextSize="48sp"
        android:autoSizeStepGranularity="2sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Task 3 -->
    <TextView
        android:id="@+id/taskThree"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_marginTop="475dp"
        android:gravity="center"
        android:fontFamily="sans-serif-condensed"
        android:text="TASK 3: DUE"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="24sp"
        android:autoSizeMaxTextSize="48sp"
        android:autoSizeStepGranularity="2sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:backgroundTint="#00000000"
        app:cornerRadius="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.764"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.398" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDone2"
        android:layout_width="97dp"
        android:layout_height="53dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:backgroundTint="#00000000"
        app:cornerRadius="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/taskTwo"
        app:layout_constraintHorizontal_bias="0.757"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.556" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDone3"
        android:layout_width="97dp"
        android:layout_height="53dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:backgroundTint="#00000000"
        app:cornerRadius="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/taskTwo"
        app:layout_constraintHorizontal_bias="0.786"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.718" />


</androidx.constraintlayout.widget.ConstraintLayout>